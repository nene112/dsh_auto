{
  "name": "deepseek-harness-deploy",
  "private": true,
  "description": "Portable DeepSeek Harness launcher with automatic environment setup and optional Tailscale access",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1",
    "install:deps": "npm ci --no-fund --no-audit || npm install --no-fund --no-audit"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.3"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.1-rc.3": true,
    "@google/genai@2.21.0": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true
  }
}
